@{
    ViewBag.Title = Textos.Comun_Inicio;
    Layout = "_Layout";

    // Datos quemados para el prototipo.
    var categorias = new[]
    {
        new {
            Nombre = Textos.Comun_Maquillaje,
            Descripcion = Textos.Inicio_CategoriaMaquillajeDesc,
            Imagen = "shop01.png"
        },
        new {
            Nombre = Textos.Comun_CuidadoFacial,
            Descripcion = Textos.Inicio_CategoriaFacialDesc,
            Imagen = "shop02.png"
        },
        new {
            Nombre = Textos.Comun_Accesorios,
            Descripcion = Textos.Inicio_CategoriaAccesoriosDesc,
            Imagen = "shop03.png"
        }
    };

    var productos = new[]
    {
        new {
            Nombre = Textos.Inicio_ProductoLabial,
            Categoria = Textos.Inicio_CategoriaLabios,
            PrecioCrc = 4500m,
            Imagen = "product01.png"
        },
        new {
            Nombre = Textos.Inicio_ProductoPaleta,
            Categoria = Textos.Inicio_CategoriaOjos,
            PrecioCrc = 12500m,
            Imagen = "product02.png"
        },
        new {
            Nombre = Textos.Inicio_ProductoBase,
            Categoria = Textos.Inicio_CategoriaRostro,
            PrecioCrc = 8900m,
            Imagen = "product03.png"
        },
        new {
            Nombre = Textos.Inicio_ProductoBrochas,
            Categoria = Textos.Comun_Accesorios,
            PrecioCrc = 9500m,
            Imagen = "product04.png"
        }
    };
}

<div class="agata-inicio">

    <!-- Bienvenida -->
    <section class="agata-hero">
        <div class="container">
            <div class="row">

                <div class="col-md-7">
                    <div class="agata-hero-contenido">
                        <span class="agata-hero-etiqueta">
                            ÁGATA MAKEUP
                        </span>

                        <h1>
                            @Textos.Inicio_HeroTitulo
                            <span>@Textos.Inicio_HeroTituloResaltado</span>
                        </h1>

                        <p>
                            @Textos.Inicio_HeroTexto
                        </p>

                        <a asp-action="Index" asp-controller="Productos"
                           class="home-boton">
                            @Textos.Inicio_ExplorarProductos
                            <i class="fa fa-arrow-right"
                               aria-hidden="true"></i>
                        </a>
                    </div>
                </div>

                <div class="col-md-5 hidden-sm hidden-xs">
                    <div class="agata-hero-decoracion"
                         aria-hidden="true">
                        <div class="agata-circulo circulo-1"></div>
                        <div class="agata-circulo circulo-2"></div>
                        <div class="agata-hero-letra">A</div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Categorías -->
    <section class="home-seccion">
        <div class="container">

            <div class="home-titulo">
                <div>
                    <span class="home-subtitulo">@Textos.Inicio_EncontraTuEstilo</span>
                    <h2>@Textos.Inicio_ExploraCategorias</h2>
                </div>
            </div>

            <div class="row">
                @foreach (var categoria in categorias)
                {
                    <div class="col-md-4 col-sm-6">
                        <a asp-action="Index" asp-controller="Productos"
                           class="categoria-home">

                            <div class="categoria-home-imagen">
                                <img src="@Url.Content("~/images/" + categoria.Imagen)"
                                     alt="@categoria.Nombre" />
                            </div>

                            <div class="categoria-home-overlay">
                                <div>
                                    <span>@categoria.Descripcion</span>
                                    <h3>@categoria.Nombre</h3>
                                    <strong>
                                        @Textos.Inicio_ExplorarCatalogo →
                                    </strong>
                                </div>
                            </div>

                        </a>
                    </div>
                }
            </div>

        </div>
    </section>

    <!-- Productos destacados -->
    <section class="home-seccion home-section-suave">
        <div class="container">

            <div class="home-titulo">
                <div>
                    <span class="home-subtitulo">
                        @Textos.Inicio_SeleccionParaVos
                    </span>
                    <h2>@Textos.Inicio_ProductosDestacados</h2>
                </div>

                <a asp-action="Index" asp-controller="Productos"
                   class="home-ver-todos">
                    @Textos.Inicio_VerCatalogo →
                </a>
            </div>

            <div class="row home-productos-grid">
                @foreach (var producto in productos)
                {
                    <div class="col-md-3 col-sm-6 col-xs-12">
                        <article class="home-producto">

                            <div class="home-producto-imagen">
                                <img src="@Url.Content("~/images/" + producto.Imagen)"
                                     alt="@producto.Nombre"
                                     loading="lazy" />
                            </div>

                            <div class="home-producto-info">
                                <p>@producto.Categoria</p>
                                <h3>@producto.Nombre</h3>

                                @* El precio base está en colones; el selector de moneda lo convierte. *@
                                <strong class="home-producto-precio"
                                        data-precio-crc="@producto.PrecioCrc.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    @producto.PrecioCrc.ToString("C", new System.Globalization.CultureInfo("es-CR"))
                                </strong>

                                <span class="home-disponible">
                                    @Textos.Inicio_Disponible
                                </span>
                            </div>

                            <div class="home-producto-accion">
                                <a asp-action="Index" asp-controller="Productos"
                                   class="home-btn-producto">
                                    @Textos.Inicio_VerEnCatalogo
                                    <i class="fa fa-arrow-right"
                                       aria-hidden="true"></i>
                                </a>
                            </div>

                        </article>
                    </div>
                }
            </div>

        </div>
    </section>

    <!-- Cierre -->
    <section class="home-cierre">
        <div class="container">
            <div class="home-cierre-contenido">
                <span>ÁGATA MAKEUP</span>

                <h2>@Textos.Inicio_CierreTitulo</h2>

                <p>
                    @Textos.Inicio_CierreTexto
                </p>

                <a asp-action="Index" asp-controller="Productos"
                   class="home-boton">
                    @Textos.Inicio_VerTodos
                </a>
            </div>
        </div>
    </section>

</div>

