@model RegisterRequestModel

@{
    ViewBag.Title = Textos.Cuenta_RegistroTitulo;
}

<div class="section auth-section">
    <div class="container">
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <div class="auth-card">
                    <div class="auth-header text-center">
                        <h2>@Textos.Cuenta_CrearCuenta</h2>
                        <p>@Textos.Cuenta_RegistroTexto</p>
                    </div>

                    <form asp-action="Registro" asp-controller="Cuenta" method="post">

                        @Html.AntiForgeryToken()

                        @if (ViewBag.Mensaje != null)
                        {
                            <div class="alert alert-danger text-center" role="alert">
                                @ViewBag.Mensaje
                            </div>
                        }

                        <div class="form-group">
                            <label>@Textos.Cuenta_NombreCompleto</label>
                            <input class="input" type="text" placeholder="@Textos.Cuenta_IngreseNombre">
                        </div>

                        <div class="form-group">
                            <label for="CorreoElectronico">@Textos.Comun_CorreoElectronico</label>
                            <input class="input" type="email" asp-for="CorreoElectronico" placeholder="@Textos.Comun_CorreoEjemplo">
                        </div>

                        <div class="form-group">
                            <label>@Textos.Comun_Telefono</label>
                            <input class="input" type="tel" placeholder="8888-8888">
                        </div>

                        <div class="form-group">
                            <label>@Textos.Comun_Direccion</label>
                            <input class="input" type="text" placeholder="@Textos.Cuenta_IngreseDireccion">
                        </div>

                        <div class="form-group">
                            <label for="Contrasenna">@Textos.Comun_Contrasena</label>
                            <input class="input" type="password" asp-for="Contrasenna" placeholder="@Textos.Cuenta_CreeContrasena">
                        </div>

                        <div class="form-group">
                            <label>@Textos.Cuenta_ConfirmarContrasena</label>
                            <input class="input" type="password" placeholder="@Textos.Cuenta_RepitaContrasena">
                        </div>

                        <button type="submit" class="primary-btn auth-btn">@Textos.Cuenta_Registrarme</button>

                        <div class="auth-links text-center">
                            <span>@Textos.Cuenta_YaTieneCuenta</span>
                            <a asp-action="Login" asp-controller="Cuenta">@Textos.Comun_IniciarSesion</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>