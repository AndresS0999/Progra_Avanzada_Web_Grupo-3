@model LoginRequestModel

@{
    ViewBag.Title = Textos.Comun_IniciarSesion;
    ViewBag.OcultarHeader = true;
}

<div class="section auth-section">
    <div class="container">
        <div class="row">
            <div class="col-md-5 col-md-offset-3">
                <div class="auth-card">
                    <div class="auth-header text-center">
                        <h2>@Textos.Comun_IniciarSesion</h2>
                        <p>@Textos.Cuenta_LoginTexto</p>
                    </div>

                    <form asp-action="Login" asp-controller="Cuenta" method="post">

                        @Html.AntiForgeryToken()

                        @if (ViewBag.Mensaje != null)
                        {
                            <div class="alert alert-danger text-center" role="alert">
                                @ViewBag.Mensaje
                            </div>
                        }

                        <div class="form-group">
                            <label for="CorreoElectronico">@Textos.Comun_CorreoElectronico</label>
                            <input class="input" type="email" asp-for="CorreoElectronico" placeholder="@Textos.Comun_CorreoEjemplo">
                        </div>

                        <div class="form-group">
                            <label for="Contrasenna">@Textos.Comun_Contrasena</label>
                            <input class="input" type="password" asp-for="Contrasenna" placeholder="@Textos.Comun_IngreseContrasena">
                        </div>

                        <div class="form-group">
                            <div class="input-checkbox">
                                <input type="checkbox" id="recordarme">
                                <label for="recordarme">
                                    <span></span>
                                    @Textos.Cuenta_Recordarme
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="primary-btn auth-btn">@Textos.Cuenta_Ingresar</button>

                        <div class="auth-links text-center">
                            <a asp-action="Recuperar" asp-controller="Cuenta">@Textos.Cuenta_OlvidoContrasena</a>
                            <br>
                            <span>@Textos.Cuenta_NoTieneCuenta</span>
                            <a asp-action="Registro" asp-controller="Cuenta">@Textos.Cuenta_CrearCuenta</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>