@{
    ViewData["Title"] = "Finalizar compra";
}

<link rel="stylesheet" href="~/css/agata-checkout.css" asp-append-version="true" />

<div id="breadcrumb" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h3 class="breadcrumb-header">Finalizar compra</h3>
                <ul class="breadcrumb-tree">
                    <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="active">Finalizar compra</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<section class="section agata-checkout">
    <div class="container">
        <form id="agata-checkout-form" novalidate>
            <div class="row">
                <div class="col-md-7">
                    <div class="billing-details">
                        <div class="section-title"><h3 class="title">Datos de contacto y facturación</h3></div>
                        <div class="row">
                            <div class="col-sm-6 form-group">
                                <label for="Nombre">Nombre</label>
                                <input class="input" id="Nombre" name="Nombre" type="text" autocomplete="given-name" placeholder="Nombre" required />
                            </div>
                            <div class="col-sm-6 form-group">
                                <label for="Apellidos">Apellidos</label>
                                <input class="input" id="Apellidos" name="Apellidos" type="text" autocomplete="family-name" placeholder="Apellidos" required />
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="CorreoElectronico">Correo electrónico</label>
                            <input class="input" id="CorreoElectronico" name="CorreoElectronico" type="email" autocomplete="email" placeholder="ejemplo@correo.com" required />
                        </div>
                        <div class="form-group">
                            <label for="Telefono">Teléfono</label>
                            <input class="input" id="Telefono" name="Telefono" type="tel" autocomplete="tel" placeholder="Número de teléfono" required />
                        </div>
                        <div class="form-group">
                            <label for="Direccion">Dirección</label>
                            <input class="input" id="Direccion" name="Direccion" type="text" autocomplete="street-address" placeholder="Dirección de entrega" required />
                        </div>
                        <div class="row">
                            <div class="col-sm-6 form-group">
                                <label for="Provincia">Provincia</label>
                                <input class="input" id="Provincia" name="Provincia" type="text" placeholder="Provincia" required />
                            </div>
                            <div class="col-sm-6 form-group">
                                <label for="Canton">Cantón</label>
                                <input class="input" id="Canton" name="Canton" type="text" placeholder="Cantón" required />
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="Distrito">Distrito</label>
                            <input class="input" id="Distrito" name="Distrito" type="text" placeholder="Distrito" required />
                        </div>
                    </div>

                    <div class="shiping-details">
                        <div class="section-title"><h3 class="title">Dirección de entrega</h3></div>
                        <label class="agata-checkout-toggle" for="DireccionDiferente">
                            <input type="checkbox" id="DireccionDiferente" name="DireccionDiferente" />
                            Entregar en otra dirección
                        </label>
                        <div id="agata-direccion-alternativa" hidden>
                            <div class="form-group">
                                <label for="NombreEntrega">Persona que recibe</label>
                                <input class="input" id="NombreEntrega" name="NombreEntrega" type="text" placeholder="Nombre completo" />
                            </div>
                            <div class="form-group">
                                <label for="DireccionEntrega">Otra dirección</label>
                                <input class="input" id="DireccionEntrega" name="DireccionEntrega" type="text" placeholder="Dirección de entrega" />
                            </div>
                        </div>
                    </div>
                    <div class="order-notes form-group">
                        <label for="NotasPedido">Notas del pedido (opcional)</label>
                        <textarea class="input" id="NotasPedido" name="NotasPedido" placeholder="Indicaciones para la entrega"></textarea>
                    </div>
                </div>

                <div class="col-md-5">
                    <aside class="order-details agata-checkout-resumen">
                        <div class="section-title text-center"><h3 class="title">Resumen del pedido</h3></div>
                        <div class="order-summary">
                            <div class="order-col"><div><strong>Producto</strong></div><div><strong>Total</strong></div></div>
                            <div class="order-col"><div>Envío</div><div>Por calcular</div></div>
                            <div class="order-col"><div><strong>Total</strong></div><div><strong class="order-total">Por calcular</strong></div></div>
                        </div>
                        <div class="payment-method">
                            <h4>Método de pago</h4>
                            <div class="agata-checkout-metodos"></div>
                        </div>
                        <label class="agata-checkout-toggle" for="ConfirmarDatos">
                            <input type="checkbox" id="ConfirmarDatos" name="ConfirmarDatos" />
                            Confirmo que los datos ingresados son correctos.
                        </label>
                        <button type="button" id="agata-confirmar-pedido" class="primary-btn order-submit">
                            Confirmar pedido
                        </button>
                    </aside>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/js/agata-checkout.js" asp-append-version="true"></script>
}
