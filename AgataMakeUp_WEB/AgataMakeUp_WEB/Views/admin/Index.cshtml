@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Indicadores -->
<div class="row g-3 mb-4">

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="small-box text-bg-primary">
            <div class="inner">
                <h3>18</h3>
                <p>Productos registrados</p>
            </div>
            <a href="#" class="small-box-footer" data-visual>
                Gestión de productos →
            </a>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="small-box text-bg-success">
            <div class="inner">
                <h3>18</h3>
                <p>Productos activos</p>
            </div>
            <a asp-controller="Productos"
               asp-action="Index"
               class="small-box-footer">
               Ver catálogo →
            </a>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="small-box text-bg-warning">
            <div class="inner">
                <h3>0</h3>
                <p>Productos con bajo stock</p>
            </div>
            <a href="#" class="small-box-footer" data-visual>
                Revisar inventario →
            </a>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="small-box text-bg-info">
            <div class="inner">
                <h3>5</h3>
                <p>Clientes registrados</p>
            </div>
            <a href="#" class="small-box-footer" data-visual>
                Gestión de clientes →
            </a>
        </div>
    </div>

</div>

<!-- Resumen -->
<div class="row g-3 mb-4">

    <div class="col-12 col-lg-4">
        <div class="card card-outline card-primary h-100">
            <div class="card-header">
                <h3 class="card-title">Pedidos</h3>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-3">
                    <span>Total de pedidos</span>
                    <strong>6</strong>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span>Pedidos registrados</span>
                    <span class="badge text-bg-warning">1</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Pedidos enviados</span>
                    <span class="badge text-bg-success">1</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card card-outline card-info h-100">
            <div class="card-header">
                <h3 class="card-title">Clientes</h3>
            </div>
            <div class="card-body">
                <h2 class="text-agata fw-bold">5</h2>
                <p class="text-muted">
                    Clientes activos de 5 registrados
                </p>
                <div class="progress"
                     role="progressbar"
                     aria-label="Porcentaje de clientes activos"
                     aria-valuenow="100"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    <div class="progress-bar" style="width: 100%;">
                        100%
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card card-outline card-success h-100">
            <div class="card-header">
                <h3 class="card-title">Ventas</h3>
            </div>
            <div class="card-body">
                <p class="text-muted mb-1">Ventas del mes</p>
                <h2 class="text-agata fw-bold">₡0,00</h2>
                <hr />
                <div class="d-flex justify-content-between">
                    <span>Ventas acumuladas</span>
                    <strong>₡91 505,00</strong>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Estado general -->
<div class="card mb-4">
    <div class="card-header">
        <h3 class="card-title">Estado general de la tienda</h3>
        <p class="text-muted small mb-0">
            Resumen de productos, inventario, clientes y pedidos.
        </p>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col" class="ps-3">Módulo</th>
                        <th scope="col">Cantidad</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th scope="row" class="ps-3">Productos</th>
                        <td>18</td>
                        <td>
                            <span class="badge text-bg-primary">
                                Disponible
                            </span>
                        </td>
                        <td>18 productos activos</td>
                    </tr>
                    <tr>
                        <th scope="row" class="ps-3">Inventario</th>
                        <td>0</td>
                        <td>
                            <span class="badge text-bg-success">
                                Correcto
                            </span>
                        </td>
                        <td>Sin productos con bajo stock</td>
                    </tr>
                    <tr>
                        <th scope="row" class="ps-3">Clientes</th>
                        <td>5</td>
                        <td>
                            <span class="badge text-bg-info">
                                Registrados
                            </span>
                        </td>
                        <td>5 cuentas activas</td>
                    </tr>
                    <tr>
                        <th scope="row" class="ps-3">Pedidos</th>
                        <td>6</td>
                        <td>
                            <span class="badge text-bg-warning">
                                En operación
                            </span>
                        </td>
                        <td>1 pendiente de procesamiento</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>