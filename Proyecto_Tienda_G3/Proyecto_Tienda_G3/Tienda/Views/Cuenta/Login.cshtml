@{
    ViewBag.Title = Textos.Comun_IniciarSesion;
    ViewBag.OcultarHeader = true;
}

<div class="section auth-section">
    <div class="container">
        <div class="row">
            <div class="col-md-5 col-md-offset-3">
                <div class="auth-card">
                    <div class="auth-header text-center">
                        <h2>@Textos.Comun_IniciarSesion</h2>
                        <p>@Textos.Cuenta_LoginTexto</p>
                    </div>

                    <form>
                        <div class="form-group">
                            <label>@Textos.Comun_CorreoElectronico</label>
                            <input class="input" type="email" placeholder="@Textos.Comun_CorreoEjemplo">
                        </div>

                        <div class="form-group">
                            <label>@Textos.Comun_Contrasena</label>
                            <input class="input" type="password" placeholder="@Textos.Comun_IngreseContrasena">
                        </div>

                        <div class="form-group">
                            <div class="input-checkbox">
                                <input type="checkbox" id="recordarme">
                                <label for="recordarme">
                                    <span></span>
                                    @Textos.Cuenta_Recordarme
                                </label>
                            </div>
                        </div>

                        <button type="button" class="primary-btn auth-btn">@Textos.Cuenta_Ingresar</button>

                        <div class="auth-links text-center">
                            <a href="@Url.Action("Recuperar", "Cuenta")">@Textos.Cuenta_OlvidoContrasena</a>
                            <br>
                            <span>@Textos.Cuenta_NoTieneCuenta</span>
                            <a href="@Url.Action("Registro", "Cuenta")">@Textos.Cuenta_CrearCuenta</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>