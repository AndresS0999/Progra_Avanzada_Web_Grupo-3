<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - Administración Ágata</title>

    <link rel="stylesheet"
          href="@Url.Content("~/Content/AdminLTE/css/adminlte.min.css")" />

    <link rel="stylesheet"
          href="@Url.Content("~/Content/AdminLTE/css/agata-admin.css")" />

    @RenderSection("styles", required: false)
</head>

<body class="layout-fixed sidebar-expand-lg">
    <div class="app-wrapper">

        <!-- Encabezado -->
        <nav class="app-header navbar navbar-expand agata-header">
            <div class="container-fluid">

                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link"
                           data-lte-toggle="sidebar"
                           href="#"
                           role="button"
                           aria-label="Mostrar u ocultar menú">
                            <span aria-hidden="true">☰</span>
                        </a>
                    </li>

                    <li class="nav-item d-none d-md-block">
                        <a href="@Url.Action("Index", "Admin")"
                           class="nav-link">
                            Panel administrativo
                        </a>
                    </li>

                    <li class="nav-item d-none d-md-block">
                        <a href="@Url.Action("Index", "Home")"
                           class="nav-link">
                            Ver tienda
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <span class="nav-link">Usuario</span>
                    </li>
                </ul>

            </div>
        </nav>

        <!-- Menú lateral -->
        <aside class="app-sidebar agata-sidebar shadow">

            <div class="sidebar-brand">
                <a href="@Url.Action("Index", "Admin")"
                   class="brand-link">
                    <div class="brand-content">
                        <span class="brand-symbol">A</span>
                        <span class="brand-text">
                            Ágata Administración
                        </span>
                    </div>
                </a>
            </div>

            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    <ul class="nav sidebar-menu flex-column">

                        <li class="nav-header">PRINCIPAL</li>

                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Admin")"
                               class="nav-link active"
                               aria-current="page">
                                <span class="nav-icon" aria-hidden="true">▣</span>
                                <p>Dashboard</p>
                            </a>
                        </li>

                        <li class="nav-header">CATÁLOGO</li>

                        <li class="nav-item">
                            <a href="#" class="nav-link" data-visual>
                                <span class="nav-icon" aria-hidden="true">◆</span>
                                <p>Productos</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link" data-visual>
                                <span class="nav-icon" aria-hidden="true">▦</span>
                                <p>Categorías</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link" data-visual>
                                <span class="nav-icon" aria-hidden="true">◇</span>
                                <p>Marcas</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link" data-visual>
                                <span class="nav-icon" aria-hidden="true">%</span>
                                <p>Promociones</p>
                            </a>
                        </li>

                        <li class="nav-header">OPERACIÓN</li>

                        <li class="nav-item">
                            <a href="#" class="nav-link" data-visual>
                                <span class="nav-icon" aria-hidden="true">☷</span>
                                <p>Pedidos</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link" data-visual>
                                <span class="nav-icon" aria-hidden="true">▤</span>
                                <p>Inventario</p>
                            </a>
                        </li>

                        <li class="nav-header">ADMINISTRACIÓN</li>

                        <li class="nav-item">
                            <a href="#" class="nav-link" data-visual>
                                <span class="nav-icon" aria-hidden="true">♙</span>
                                <p>Usuarios</p>
                            </a>
                        </li>

                        <li class="nav-header">SISTEMA</li>

                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Home")"
                               class="nav-link">
                                <span class="nav-icon" aria-hidden="true">↗</span>
                                <p>Ir a la tienda</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link" data-visual>
                                <span class="nav-icon" aria-hidden="true">◉</span>
                                <p>Mi perfil</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="#" class="nav-link" data-visual>
                                <span class="nav-icon" aria-hidden="true">×</span>
                                <p>Cerrar sesión</p>
                            </a>
                        </li>

                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Contenido de cada vista -->
        <main class="app-main">

            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-6">
                            <h3 class="mb-0">@ViewBag.Title</h3>
                        </div>

                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-end">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Admin")">
                                        Administración
                                    </a>
                                </li>
                                <li class="breadcrumb-item active"
                                    aria-current="page">
                                    @ViewBag.Title
                                </li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>

            <div class="app-content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>

        </main>

        <!-- Pie de página -->
        <footer class="app-footer">
            <div class="float-end d-none d-sm-inline">
                Tienda Ágata MakeUp
            </div>
            <strong>Administración Ágata</strong> &copy; 2026
        </footer>

    </div>

    <script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>
    <script src="@Url.Content("~/Scripts/AdminLTE/adminlte.min.js")"></script>

    <script>
                // Evita saltos al pulsar opciones que todavía son visuales.
                document.querySelectorAll("[data-visual]").forEach(function (link) {
                    link.addEventListener("click", function (event) {
                        event.preventDefault();
                    });
                });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>