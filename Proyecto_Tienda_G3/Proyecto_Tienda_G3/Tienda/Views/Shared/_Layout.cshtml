    <!-- jQuery Plugins -->
    <script src="@Url.Content("~/Content/js/jquery.min.js")"></script>
    <script src="@Url.Content("~/Content/js/bootstrap.min.js")"></script>
    <script src="@Url.Content("~/Content/js/slick.min.js")"></script>
    <script src="@Url.Content("~/Content/js/nouislider.min.js")"></script>
    <script src="@Url.Content("~/Content/js/jquery.zoom.min.js")"></script>
    <script src="@Url.Content("~/Content/js/main.js")"></script>

    <script>
        // Selector de moneda: cambia la etiqueta, recuerda la elección y convierte
        // los precios marcados con data-precio-crc (precio base en colones).
        (function ($) {
            var $actual = $(".selector-moneda .moneda-actual");

            // Tipos de cambio fijos y aproximados para el prototipo: colones por unidad.
            var monedas = {
                CRC: { colones: 1, formato: "es-CR" },
                USD: { colones: 505, formato: "en-US" },
                EUR: { colones: 590, formato: "es-ES" },
                MXN: { colones: 28, formato: "en-US" }
            };

            function actualizarPrecios(codigo) {
                var moneda = monedas[codigo];
                var formateador = new Intl.NumberFormat(moneda.formato, {
                    style: "currency",
                    currency: codigo
                });

                $("[data-precio-crc]").each(function () {
                    var precioCrc = parseFloat($(this).data("precio-crc"));
                    $(this).text(formateador.format(precioCrc / moneda.colones));
                });
            }

            function aplicarMoneda(codigo) {
                var $opcion = $(".selector-moneda [data-moneda='" + codigo + "']");
                if (!$opcion.length || !monedas[codigo]) return;
                $actual.html($opcion.find("i").prop("outerHTML") + " " + codigo);
                actualizarPrecios(codigo);
            }

            var monedaGuardada = null;
            try { monedaGuardada = localStorage.getItem("moneda"); } catch (e) { }
            aplicarMoneda(monedas[monedaGuardada] ? monedaGuardada : "USD");

            $(".selector-moneda [data-moneda]").on("click", function (event) {
                event.preventDefault();
                var codigo = $(this).data("moneda");
                aplicarMoneda(codigo);
                try { localStorage.setItem("moneda", codigo); } catch (e) { }
            });
        })(jQuery);
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
